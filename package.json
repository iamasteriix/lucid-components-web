{
  "name": "@skyline-uikit",
  "private": false,
  "scripts": {
    "dev:web": "docker compose up -d uikit-web",
    "dev:native": "docker compose up -d uikit-native",
    "dev:icons": "docker compose up -d uikit-icons",
    "bash:web": "docker compose exec -it uikit-web bash",
    "bash:native": "docker compose exec -it uikit-native bash"
  },
  "workspaces": [
    "packages/web",
    "packages/native",
    "packages/icons"
  ],
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
